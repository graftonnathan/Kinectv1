      </setting>
      <setting name="TtsSpeaker" serializeAs="String">
        <value>af_aoede</value>
      </setting>
      <setting name="TtsModelPath" serializeAs="String">
        <value>models\tts\kokoro\onnx\model.onnx</value>
      </setting>
      <setting name="TtsModelFolder" serializeAs="String">
        <value>models\tts\kokoro</value>
      </setting>
      <setting name="VoiceActivityThreshold" serializeAs="String">
        <value>300</value>
      </setting>
      <setting name="DiscordVoiceActivityThreshold" serializeAs="String">
        <value>25</value>
      </setting>
      <setting name="VadSilenceTimeoutMs" serializeAs="String">
        <value>150</value>
      </setting>
      <setting name="VadDebounceTimeoutMs" serializeAs="String">
        <value>200</value>
      </setting>
      <setting name="WindowWidth" serializeAs="String">
        <value>900</value>
      </setting>
      <setting name="WindowHeight" serializeAs="String">
        <value>900</value>
      </setting>
      <setting name="WindowLeft" serializeAs="String">
        <value>100</value>
      </setting>
      <setting name="WindowTop" serializeAs="String">
        <value>100</value>
      </setting>
      <setting name="LocalTtsVolume" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="DiscordTtsVolume" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="AppScenario" serializeAs="String">
        <value>Local</value>
      </setting>
    </Kinectv1.Properties.Settings>
  </userSettings>
  
  <applicationSettings>
    <Kinectv1.Properties.Settings>
      <setting name="KinectMode" serializeAs="String">
        <value>Native</value>
      </setting>
