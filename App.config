      <setting name="DiscordAutoJoinVoice" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="DarkMode" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="WindowState" serializeAs="String">
