        <value>prompts\system.txt</value>
      </setting>
      <setting name="TtsEnabled" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="TtsUseGpu" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="SttInputDevice" serializeAs="String">
        <value>Default</value>
      </setting>
      <setting name="TtsOutputDevice" serializeAs="String">
        <value>Default</value>
      </setting>
      <setting name="DiscordBotToken" serializeAs="String">
        <value>MTQwNjAwODUyNzYzMzM4NzU2Mg.GcEjb1.yvMA3GmSKEO97VAAugrDqXgPSXa4PPjYHmwbJw</value>
      </setting>
