<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>10.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyTitle>Kinect Face &amp; Voice Recognition</AssemblyTitle>
    <AssemblyProduct>Kinectv1</AssemblyProduct>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>False</NuGetAudit>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="tools\obj\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <!-- Exclude legacy Old folder to prevent duplicate symbol ambiguities -->
    <Compile Remove="Old\**\*.cs" />
    <!-- Exclude legacy TeamTalk folder (replaced by WebRTC) -->
    <Compile Remove="TeamTalk\**\*.cs" />
    <None Include="tools\**\*" Exclude="tools\obj\**\*" />
    <None Include="tests\**\*" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.22.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Discord.Net" Version="3.18.0" />
    <PackageReference Include="Discord.Net.Commands" Version="3.18.0" />
    <PackageReference Include="Discord.Net.WebSocket" Version="3.18.0" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <PackageReference Include="SIPSorcery" Version="6.2.4" />
    <PackageReference Include="Concentus" Version="1.1.7" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src\UI\Settings\**\*.cs" />
    <Page Remove="src\UI\Settings\**\*.xaml" />
  </ItemGroup>

  <!-- Remove legacy duplicate root files if any exist -->
  <ItemGroup>
    <Compile Remove="VoiceRecognizer.cs" />
    <Compile Remove="EnhancedKinectFaceTracker.cs" />
    <Compile Remove="IdentityFusionTracker.cs" />
    <Compile Remove="SpeakerIdentifier.cs" />
    <Compile Remove="ConsoleManager.cs" />
    <Compile Remove="Telemetry.cs" />
    <Compile Remove="MemoryStore.cs" />
    <Compile Remove="CoquiTtsService.cs" />
    <Compile Remove="KokoroTtsService.cs" />
    <Compile Remove="OllamaConversationManager.cs" />
  </ItemGroup>

  <Target Name="OrganizeDevLibs" BeforeTargets="Build">
    <MakeDir Directories="$(ProjectDir)lib" Condition="!Exists('$(ProjectDir)lib')" />
    <MakeDir Directories="$(ProjectDir)lib\onnxruntime" Condition="!Exists('$(ProjectDir)lib\onnxruntime')" />
    <MakeDir Directories="$(ProjectDir)lib\discord" Condition="!Exists('$(ProjectDir)lib\discord')" />
    <MakeDir Directories="$(ProjectDir)lib\cuda" Condition="!Exists('$(ProjectDir)lib\cuda')" />
    <MakeDir Directories="$(ProjectDir)lib\cudnn" Condition="!Exists('$(ProjectDir)lib\cudnn')" />
    <MakeDir Directories="$(ProjectDir)lib\tensorrt" Condition="!Exists('$(ProjectDir)lib\tensorrt')" />
    <Copy SourceFiles="@(OrtDlls)" DestinationFolder="$(ProjectDir)lib\onnxruntime\" SkipUnchangedFiles="true" Condition=" '@(OrtDlls)' != '' " />
    <Copy SourceFiles="@(DiscordDlls)" DestinationFolder="$(ProjectDir)lib\discord\" SkipUnchangedFiles="true" Condition=" '@(DiscordDlls)' != '' " />
    <Copy SourceFiles="@(CudaLocalDlls)" DestinationFolder="$(ProjectDir)lib\cuda\" SkipUnchangedFiles="true" Condition=" '@(CudaLocalDlls)' != '' " />
    <Copy SourceFiles="@(CuDnnLocalDlls)" DestinationFolder="$(ProjectDir)lib\cudnn\" SkipUnchangedFiles="true" Condition=" '@(CuDnnLocalDlls)' != '' " />
    <Copy SourceFiles="@(TrtLocalDlls)" DestinationFolder="$(ProjectDir)lib\tensorrt\" SkipUnchangedFiles="true" Condition=" '@(TrtLocalDlls)' != '' " />
    <Delete Files="@(OrtDllsToDelete)" Condition=" '@(OrtDllsToDelete)' != '' " />
    <Delete Files="@(DiscordDllsToDelete)" Condition=" '@(DiscordDllsToDelete)' != '' " />
    <Delete Files="@(CudaLocalDllsToDelete)" Condition=" '@(CudaLocalDllsToDelete)' != '' " />
    <Delete Files="@(CuDnnLocalDllsToDelete)" Condition=" '@(CuDnnLocalDllsToDelete)' != '' " />
    <Delete Files="@(TrtLocalDllsToDelete)" Condition=" '@(TrtLocalDllsToDelete)' != '' " />
  </Target>

  <Target Name="NormalizeLibLayout" AfterTargets="OrganizeDevLibs">
    <MakeDir Directories="$(ProjectDir)lib\onnxruntime" Condition="!Exists('$(ProjectDir)lib\onnxruntime')" />
    <MakeDir Directories="$(ProjectDir)lib\discord" Condition="!Exists('$(ProjectDir)lib\discord')" />
    <MakeDir Directories="$(ProjectDir)lib\cuda" Condition="!Exists('$(ProjectDir)lib\cuda')" />
    <MakeDir Directories="$(ProjectDir)lib\cudnn" Condition="!Exists('$(ProjectDir)lib\cudnn')" />
    <MakeDir Directories="$(ProjectDir)lib\tensorrt" Condition="!Exists('$(ProjectDir)lib\tensorrt')" />

    <ItemGroup>
      <LibRootOrt Include="$(ProjectDir)lib\onnxruntime*.dll" />
      <LibRootDiscord Include="$(ProjectDir)lib\opus*.dll;$(ProjectDir)lib\libsodium*.dll" />
      <LibRootCuda Include="$(ProjectDir)lib\cud*.dll;$(ProjectDir)lib\cublas*.dll;$(ProjectDir)lib\curand*.dll;$(ProjectDir)lib\nvrtc*.dll" />
      <LibRootCuDnn Include="$(ProjectDir)lib\cudnn*.dll" />
      <LibRootTrt Include="$(ProjectDir)lib\nvinfer*.dll;$(ProjectDir)lib\nvonnxparser*.dll;$(ProjectDir)lib\myelin*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(LibRootOrt)" DestinationFolder="$(ProjectDir)lib\onnxruntime\" SkipUnchangedFiles="true" Condition=" '@(LibRootOrt)' != '' " />
    <Copy SourceFiles="@(LibRootDiscord)" DestinationFolder="$(ProjectDir)lib\discord\" SkipUnchangedFiles="true" Condition=" '@(LibRootDiscord)' != '' " />
    <Copy SourceFiles="@(LibRootCuda)" DestinationFolder="$(ProjectDir)lib\cuda\" SkipUnchangedFiles="true" Condition=" '@(LibRootCuda)' != '' " />
    <Copy SourceFiles="@(LibRootCuDnn)" DestinationFolder="$(ProjectDir)lib\cudnn\" SkipUnchangedFiles="true" Condition=" '@(LibRootCuDnn)' != '' " />
    <Copy SourceFiles="@(LibRootTrt)" DestinationFolder="$(ProjectDir)lib\tensorrt\" SkipUnchangedFiles="true" Condition=" '@(LibRootTrt)' != '' " />

    <Delete Files="@(LibRootOrt)" Condition=" '@(LibRootOrt)' != '' " />
    <Delete Files="@(LibRootDiscord)" Condition=" '@(LibRootDiscord)' != '' " />
    <Delete Files="@(LibRootCuda)" Condition=" '@(LibRootCuda)' != '' " />
    <Delete Files="@(LibRootCuDnn)" Condition=" '@(LibRootCuDnn)' != '' " />
    <Delete Files="@(LibRootTrt)" Condition=" '@(LibRootTrt)' != '' " />
  </Target>

  <Target Name="NormalizeBinLayout" AfterTargets="Build">
    <PropertyGroup>
      <OutLib>$(OutputPath)lib\</OutLib>
    </PropertyGroup>
    <MakeDir Directories="$(OutLib)onnxruntime" Condition="!Exists('$(OutLib)onnxruntime')" />
    <MakeDir Directories="$(OutLib)discord" Condition="!Exists('$(OutLib)discord')" />
    <MakeDir Directories="$(OutLib)cuda" Condition="!Exists('$(OutLib)cuda')" />
    <MakeDir Directories="$(OutLib)cudnn" Condition="!Exists('$(OutLib)cudnn')" />
    <MakeDir Directories="$(OutLib)tensorrt" Condition="!Exists('$(OutLib)tensorrt')" />

    <ItemGroup>
      <BinOrt Include="$(OutputPath)onnxruntime*.dll" />
      <BinDiscord Include="$(OutputPath)opus*.dll;$(OutputPath)libsodium*.dll" />
      <BinCuda Include="$(OutputPath)cud*.dll;$(OutputPath)cublas*.dll;$(OutputPath)curand*.dll;$(OutputPath)nvrtc*.dll" />
      <BinCuDnn Include="$(OutputPath)cudnn*.dll" />
      <BinTrt Include="$(OutputPath)nvinfer*.dll;$(OutputPath)nvonnxparser*.dll;$(OutputPath)myelin*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(BinOrt)" DestinationFolder="$(OutLib)onnxruntime\" SkipUnchangedFiles="true" Condition=" '@(BinOrt)' != '' " />
    <Copy SourceFiles="@(BinDiscord)" DestinationFolder="$(OutLib)discord\" SkipUnchangedFiles="true" Condition=" '@(BinDiscord)' != '' " />
    <Copy SourceFiles="@(BinCuda)" DestinationFolder="$(OutLib)cuda\" SkipUnchangedFiles="true" Condition=" '@(BinCuda)' != '' " />
    <Copy SourceFiles="@(BinCuDnn)" DestinationFolder="$(OutLib)cudnn\" SkipUnchangedFiles="true" Condition=" '@(BinCuDnn)' != '' " />
    <Copy SourceFiles="@(BinTrt)" DestinationFolder="$(OutLib)tensorrt\" SkipUnchangedFiles="true" Condition=" '@(BinTrt)' != '' " />

    <Delete Files="@(BinOrt)" Condition=" '@(BinOrt)' != '' " />
    <Delete Files="@(BinDiscord)" Condition=" '@(BinDiscord)' != '' " />
    <Delete Files="@(BinCuda)" Condition=" '@(BinCuda)' != '' " />
    <Delete Files="@(BinCuDnn)" Condition=" '@(BinCuDnn)' != '' " />
    <Delete Files="@(BinTrt)" Condition=" '@(BinTrt)' != '' " />
  </Target>

  <Target Name="CopyNuGetRuntimesToLib" AfterTargets="Build" BeforeTargets="NormalizeBinLayout">
    <PropertyGroup>
      <OutLib>$(OutputPath)lib\</OutLib>
    </PropertyGroup>
    <MakeDir Directories="$(OutLib)onnxruntime" Condition="!Exists('$(OutLib)onnxruntime')" />
    <MakeDir Directories="$(OutLib)discord" Condition="!Exists('$(OutLib)discord')" />
    <MakeDir Directories="$(OutLib)vosk" Condition="!Exists('$(OutLib)vosk')" />

    <ItemGroup>
      <RuntimesOrt Include="$(OutputPath)runtimes\**\onnxruntime*.dll" />
      <RuntimesDiscord Include="$(OutputPath)runtimes\**\opus*.dll;$(OutputPath)runtimes\**\libsodium*.dll" />
      <RuntimesVosk Include="$(OutputPath)runtimes\**\*vosk*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(RuntimesOrt)" DestinationFolder="$(OutLib)onnxruntime\" SkipUnchangedFiles="true" Condition=" '@(RuntimesOrt)' != '' " />
    <Copy SourceFiles="@(RuntimesDiscord)" DestinationFolder="$(OutLib)discord\" SkipUnchangedFiles="true" Condition=" '@(RuntimesDiscord)' != '' " />
    <Copy SourceFiles="@(RuntimesVosk)" DestinationFolder="$(OutLib)vosk\" SkipUnchangedFiles="true" Condition=" '@(RuntimesVosk)' != '' " />
  </Target>

  <ItemGroup>
    <Content Include="models\**\*" Condition="Exists('models')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="prompts\system.txt" Condition="Exists('prompts/system.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="prompts\**\*.txt" Condition="Exists('prompts')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- WebRTC web client files -->
  <ItemGroup>
    <Content Include="wwwroot\**\*" Condition="Exists('wwwroot')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="lib\**\*.dll" Condition="Exists('lib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="C:\Users\Naya-Side\.nuget\packages\mumblesharp\2.0.1\contentFiles\any\netstandard2.0\Audio\Codecs\Opus\Libs\32bit\opus.dll" />
    <Content Remove="C:\Users\Naya-Side\.nuget\packages\mumblesharp\2.0.1\contentFiles\any\netstandard2.0\Audio\Codecs\Opus\Libs\64bit\opus.dll" />
    <Content Remove="prompts\Dasiy.txt" />
    <Content Remove="prompts\Mommy.txt" />
  </ItemGroup>
  
  <ItemGroup>
    <None Remove="copilot-instructions.md" />
    <None Remove="models\tts\cmudict.dict" />
    <None Remove="models\tts\model.onnx" />
    <None Remove="models\tts\SpeakerList.txt" />
    <None Remove="models\tts\symbols.txt" />
    <None Remove="prompts\Dasiy.txt" />
    <None Remove="prompts\Mommy.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include=".github\workflows\agent-bridge.yml" />
    <None Include=".github\workflows\asr-testing.yml" />
    <None Include=".github\workflows\copilot-task-runner.yml" />
    <None Include=".github\workflows\pr-summary.yml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Settings\default.json">
      <LogicalName>$(AssemblyName).Settings.default.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\FaceTracking\" />
    <Folder Include="Settings\UI\Discord\" />
    <Folder Include="Settings\UI\Models\" />
    <Folder Include="Settings\UI\Ollama\" />
    <Folder Include="Settings\Validation\" />
    <Folder Include="src\Audio\" />
    <Folder Include="src\UI\Settings\Editors\" />
    <Folder Include="src\UI\Validation\" />
  </ItemGroup>

  <Target Name="VerifyRuntimeSetup" AfterTargets="Build">
    <Message Text="✅ .NET 8.0 Build Status:" Importance="high" />
    <Message Text="Build completed - using .NET 8.0 with WPF support" Importance="high" />
    <Message Text="✅ Using Newtonsoft.Json for JSON serialization" Importance="high" />
    <Message Text="✅ System prompt files copied to output directory" Importance="high" />
  </Target>

  <Target Name="VerifySystemPrompt" AfterTargets="Build" Condition="Exists('$(OutputPath)prompts\system.txt')">
    <Message Text="System prompt file verified in output: $(OutputPath)prompts/system.txt" Importance="high" />
  </Target>
  
  <Target Name="WarnMissingSystemPrompt" AfterTargets="Build" Condition="!Exists('$(OutputPath)prompts\system.txt')">
    <Warning Text="System prompt file not found in output directory. Create prompts\system.txt in project root." />
  </Target>

  <Target Name="EnsureDiscordVoiceNatives" AfterTargets="Build">
    <PropertyGroup>
      <OpusOut>$(OutputPath)opus.dll</OpusOut>
      <SodiumOut>$(OutputPath)libsodium.dll</SodiumOut>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)download-discord-natives.ps1&quot;" WorkingDirectory="$(ProjectDir)" Condition="!Exists('$(OpusOut)') Or !Exists('$(SodiumOut)')" ContinueOnError="true" />
    <ItemGroup>
      <DiscordLibs Include="$(ProjectDir)lib\audio\opus.dll" Condition="Exists('$(ProjectDir)lib\audio\opus.dll')" />
      <DiscordLibs Include="$(ProjectDir)lib\audio\libsodium.dll" Condition="Exists('$(ProjectDir)lib\audio\libsodium.dll')" />
      <DiscordLibs Include="$(ProjectDir)lib\discord\opus.dll" Condition="Exists('$(ProjectDir)lib\discord\opus.dll')" />
      <DiscordLibs Include="$(ProjectDir)lib\discord\libsodium.dll" Condition="Exists('$(ProjectDir)lib\discord\libsodium.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(DiscordLibs)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition=" '@(DiscordLibs)' != '' " />
  </Target>

  <!-- Remove BearWare.TeamTalk reference - replaced by WebRTC -->
  <!--
  <ItemGroup>
    <Reference Include="BearWare.TeamTalk">
      <HintPath>lib\teamtalk\BearWare.TeamTalk.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  -->
</Project>
