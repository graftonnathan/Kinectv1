<UserControl x:Class="Kinectv1.ModelsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <!-- Inherit theme resources from main application -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF464647"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF0078D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF107C10"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFFF8C00"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FFE74C3C"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#FF8B5CF6"/>

        <!-- Button Style -->
        <Style x:Key="ThemedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                    <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton 
                                Name="ToggleButton" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Focusable="false"
                                IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border 
                                            Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="8,3,0,3" 
                                                                  Content="{Binding Path=SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  IsHitTestVisible="False" />
                                                <Path Grid.Column="1" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource TextPrimary}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="8,3,23,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Name="DropDownBorder"
                                            Background="{DynamicResource SurfaceBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,1,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True">
                                                <StackPanel.Resources>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ComboBoxItem">
                                                                    <Border Name="Border" Padding="8,4" CornerRadius="2">
                                                                        <ContentPresenter>
                                                                            <ContentPresenter.Resources>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                                                </Style>
                                                                            </ContentPresenter.Resources>
                                                                        </ContentPresenter>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsHighlighted" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </StackPanel.Resources>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- Models Settings Header -->
                <TextBlock Text="🧠 Models Configuration" FontSize="20" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

                <!-- TTS Model Settings -->
                <Border BorderBrush="{DynamicResource AccentOrange}" BorderThickness="2" CornerRadius="6" 
                        Background="{DynamicResource SurfaceBackground}" Margin="0,0,0,20">
                    <StackPanel Margin="15">
                        <TextBlock Text="🔊 Text-to-Speech (TTS) Models" FontSize="16" FontWeight="Bold" 
                                   Foreground="{DynamicResource AccentOrange}" Margin="0,0,0,15"/>

                        <!-- TTS Model Path -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Model File:" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Name="TtsModelPathTextBox" Margin="10,0,10,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="35"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Name="BrowseTtsModelButton" Content="📁 Browse" 
                                    Width="100" Height="35" Click="BrowseTtsModelButton_Click"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Background="{DynamicResource AccentOrange}"/>
                        </Grid>

                        <!-- TTS Model Folder -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Model Folder:" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Name="TtsModelFolderTextBox" Margin="10,0,10,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="35"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Name="BrowseTtsModelFolderButton" Content="📂 Browse" 
                                    Width="100" Height="35" Click="BrowseTtsModelFolderButton_Click"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Background="{DynamicResource AccentOrange}"/>
                        </Grid>

                        <!-- TTS Voice Selection -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Voice:" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" Name="TtsVoiceComboBox" Margin="10,0,10,0" Height="35"
                                      Style="{StaticResource ThemedComboBoxStyle}"
                                      SelectionChanged="TtsVoiceComboBox_SelectionChanged"/>
                        </Grid>

                        <!-- Execution Mode -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Execution Mode:" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" Name="ExecutionModeComboBox" Margin="10,0,10,0" Height="35"
                                      Style="{StaticResource ThemedComboBoxStyle}"
                                      SelectionChanged="ExecutionModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="CPU" Tag="CPU"/>
                                <ComboBoxItem Content="GPU (CUDA)" Tag="GPU"/>
                            </ComboBox>
                        </Grid>

                        <!-- Test Section -->
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,15"/>
                        <TextBlock Text="Voice Test" FontSize="14" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Test Phrase:" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Name="TestPhraseTextBox" Margin="10,0,10,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="35"
                                     VerticalContentAlignment="Center"
                                     Text="Hello, this is a test of the text to speech system."/>
                            <Button Grid.Column="2" Name="TestVoiceButton" Content="🔊 Test Voice" 
                                    Width="120" Height="35" Click="TestVoiceButton_Click"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Background="{DynamicResource AccentGreen}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- STT Model Settings -->
                <Border BorderBrush="{DynamicResource AccentBlue}" BorderThickness="2" CornerRadius="6" 
                        Background="{DynamicResource SurfaceBackground}" Margin="0,0,0,20">
                    <StackPanel Margin="15">
                        <TextBlock Text="🎤 Speech-to-Text (STT) Models" FontSize="16" FontWeight="Bold" 
                                   Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,15"/>

                        <!-- STT Model Path -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vosk Model:" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Name="SttModelPathTextBox" Margin="10,0,10,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="35"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Name="BrowseSttModelButton" Content="📂 Browse" 
                                    Width="100" Height="35" Click="BrowseSttModelButton_Click"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Background="{DynamicResource AccentBlue}"/>
                        </Grid>

                        <!-- Speaker Embedding Model Path -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Speaker Model:" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Name="SpeakerModelPathTextBox" Margin="10,0,10,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="35"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Name="BrowseSpeakerModelButton" Content="📁 Browse" 
                                    Width="100" Height="35" Click="BrowseSpeakerModelButton_Click"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Background="{DynamicResource AccentBlue}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Name="ValidateButton" Content="✅ Validate Paths" 
                            Width="140" Height="40" Margin="0,0,10,0" Click="ValidateButton_Click"
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentPurple}"/>
                    <Button Name="SaveButton" Content="💾 Save Settings" 
                            Width="140" Height="40" Margin="0,0,10,0" Click="SaveButton_Click"
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentGreen}"/>
                    <Button Name="ResetButton" Content="🔄 Reset to Defaults" 
                            Width="150" Height="40" Click="ResetButton_Click"
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentRed}"/>
                </StackPanel>

                <!-- Status Display -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" 
                        Background="{DynamicResource WindowBackground}" Margin="0,20,0,0">
                    <TextBlock Name="StatusTextBlock" Text="Ready - Configure your TTS and STT model paths above"
                               Padding="15" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>