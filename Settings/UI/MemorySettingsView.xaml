<UserControl x:Class="Kinectv1.UI.Settings.MemorySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI">
    <UserControl.Resources>
        <!-- Dark theme brushes (local fallback) -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF464647"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF0078D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF107C10"/>

        <!-- Buttons / Inputs -->
        <Style x:Key="ThemedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Dark-themed ComboBox -->
        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="6,2,0,2"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextPrimary}"/>
                                </Grid>
                            </ToggleButton>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <Border Name="DropDownBorder" CornerRadius="4" BorderThickness="1"
                                            Background="{DynamicResource SurfaceBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained">
                                            <StackPanel.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                </Style>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
                                                    <Setter Property="Padding" Value="6,3"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ComboBoxItem">
                                                                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsHighlighted" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </StackPanel.Resources>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Text="Vector Memory Settings (3-Layer)"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <!-- Description -->
                <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16">
                    Configure the 3-layer memory system: Hot (recent raw messages), Warm (rolling summary), and Cold (vector database for semantic search).
                </TextBlock>

                <!-- Enable Vector Memory -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Enable Vector Memory" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    <CheckBox x:Name="VectorMemoryEnabledCheckBox" Grid.Column="1" Style="{StaticResource ThemedCheckBoxStyle}"/>
                </Grid>

                <!-- Hot Context Section -->
                <TextBlock Text="Hot Context (Recent Messages)" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Token Limit (1000-128000)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="HotContextTokenLimitTextBox" Grid.Column="1" Style="{StaticResource ThemedTextBoxStyle}"/>
                </Grid>

                <!-- Warm Context Section -->
                <TextBlock Text="Warm Context (Rolling Summary)" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Summary Token Limit (100-4000)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="WarmSummaryTokenLimitTextBox" Grid.Column="1" Style="{StaticResource ThemedTextBoxStyle}"/>
                </Grid>

                <!-- Memory Context Budget -->
                <TextBlock Text="Context Injection Budget" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,8"/>
                
                <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11">
                    Controls total tokens injected into the LLM prompt from memory (pinned facts + summary + retrieved chunks). Keep this small to preserve context window for actual conversation.
                </TextBlock>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Memory Budget (200-4000)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="MemoryContextBudgetTextBox" Grid.Column="1" Style="{StaticResource ThemedTextBoxStyle}"/>
                </Grid>

                <!-- Cold Context Section (Vector DB) -->
                <TextBlock Text="Cold Context (Vector Database)" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Vector DB Path" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="VectorDbPathTextBox" Grid.Column="1" Style="{StaticResource ThemedTextBoxStyle}"/>
                    <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Style="{StaticResource ThemedButtonStyle}" Click="BrowseVectorDbPathButton_Click"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Embeddings Model" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    <ComboBox x:Name="EmbeddingsModelComboBox" Grid.Column="1" IsEditable="False" Style="{StaticResource ThemedComboBoxStyle}"/>
                    <Button x:Name="RefreshEmbeddingsModelsButton" Grid.Column="2" Width="70" Margin="8,0,0,0"
                            Style="{StaticResource ThemedButtonStyle}" Click="RefreshEmbeddingsModelsButton_Click" Content="Refresh"/>
                </Grid>

                <!-- Chunking Settings -->
                <TextBlock Text="Chunking Settings" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Chunk Size (100-2000 tokens)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="ChunkSizeTokensTextBox" Grid.Column="1" Style="{StaticResource ThemedTextBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Chunk Overlap (0-500 tokens)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="ChunkOverlapTokensTextBox" Grid.Column="1" Style="{StaticResource ThemedTextBoxStyle}"/>
                </Grid>

                <!-- Retrieval Settings -->
                <TextBlock Text="Retrieval Settings" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search Top-K (1-20)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="VectorSearchTopKTextBox" Grid.Column="1" Style="{StaticResource ThemedTextBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Min Retrieval Score (0.3-1.0)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                               ToolTip="Chunks with similarity below this threshold are discarded"/>
                    <TextBox x:Name="MinRetrievalScoreTextBox" Grid.Column="1" Style="{StaticResource ThemedTextBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Recency Boost Factor (0-1)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBox x:Name="RecencyBoostFactorTextBox" Grid.Column="1" Style="{StaticResource ThemedTextBoxStyle}"/>
                </Grid>

                <!-- Memory Status Section -->
                <TextBlock Text="Memory Status" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,8"/>

                <!-- Current Memory Key (based on system prompt) -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" 
                        Background="{DynamicResource SurfaceBackground}" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Text="Current Memory:" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentMemoryKeyText" Text="(none)" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Text="Hot Context Tokens:" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HotContextTokensText" Text="--" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="2" Text="Messages in Memory:" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MessagesCountText" Text="--" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,4,0,0"/>

                        <TextBlock Grid.Row="3" Text="Vector DB Centroids:" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VectorChunksText" Text="--" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11">
                    Memory is isolated per system prompt. Each persona has its own vector database.
                </TextBlock>

                <!-- Archival Status Indicator -->
                <Border x:Name="ArchivalStatusBorder" BorderBrush="{DynamicResource AccentBlue}" BorderThickness="1" CornerRadius="4" 
                        Background="#FF1A3A5C" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ArchivalSpinner" Text="?" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ArchivalStatusText" Text="Archiving conversation to vector memory..." 
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Manual Render Button -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RenderToMemoryButton" Content="?? Archive to Memory" 
                                Style="{StaticResource ThemedButtonStyle}" Background="#FF6B21A8" Click="RenderToMemoryButton_Click"
                                ToolTip="Archive current conversation history to the vector database for the active system prompt"/>
                        <Button x:Name="RefreshStatsButton" Content="??" Width="32" Margin="8,0,0,0" 
                                Style="{StaticResource ThemedButtonStyle}" Click="RefreshStatsButton_Click"
                                ToolTip="Refresh memory statistics"/>
                    </StackPanel>
                </Grid>

                <!-- Clear Memory Button -->
                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Danger Zone:" VerticalAlignment="Center" Foreground="#FFE74C3C" FontWeight="SemiBold"/>
                    <Button x:Name="ClearMemoryButton" Grid.Column="1" Content="??? Clear Current Memory" 
                            Style="{StaticResource ThemedButtonStyle}" Background="#FFE74C3C" 
                            Click="ClearMemoryButton_Click" HorizontalAlignment="Left"
                            ToolTip="Permanently delete all memory for the current system prompt"/>
                </Grid>

                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource ThemedButtonStyle}" Background="{DynamicResource AccentGreen}" Click="SaveButton_Click" Content="Save"/>
        </StackPanel>
    </Grid>
</UserControl>
