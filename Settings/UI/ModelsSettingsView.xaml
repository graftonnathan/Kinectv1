<UserControl x:Class="Kinectv1.UI.Settings.ModelsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             FontSize="12">
    
    <UserControl.Resources>
        <!-- Inherit theme resources from main application -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF464647"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF0078D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF107C10"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFFF8C00"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FFE74C3C"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#FF8B5CF6"/>

        <!-- Button Style -->
        <Style x:Key="ThemedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="6"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                    <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="8,3,0,3" Content="{Binding Path=SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextPrimary}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="8,3,23,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Name="DropDownBorder" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,1,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True">
                                                <StackPanel.Resources>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ComboBoxItem">
                                                                    <Border Name="Border" Padding="8,4" CornerRadius="2">
                                                                        <ContentPresenter>
                                                                            <ContentPresenter.Resources>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                                                </Style>
                                                                            </ContentPresenter.Resources>
                                                                        </ContentPresenter>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsHighlighted" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </StackPanel.Resources>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style (match DiscordSettingsView) -->
        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                <!-- TTS Settings -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="0" 
                        Background="{DynamicResource WindowBackground}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Text-to-Speech (TTS)" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- TTS Enabled -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Enable TTS" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <CheckBox Grid.Column="1" Name="TtsEnabledCheckBox" Style="{StaticResource ThemedCheckBoxStyle}"/>
                        </Grid>

                        <!-- TTS Model Folder -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Model Folder" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Column="1" Name="TtsModelFolderTextBox" Margin="0,0,8,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="30"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Name="BrowseTtsModelFolderButton" Content="Browse" 
                                    Width="80" Height="30" Click="BrowseTtsModelFolderButton_Click"
                                    Style="{StaticResource ThemedButtonStyle}"/>
                        </Grid>

                        <!-- TTS Model Path -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Model File (.onnx)" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Column="1" Name="TtsModelPathTextBox" Margin="0,0,8,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="30"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Name="BrowseTtsModelButton" Content="Browse" 
                                    Width="80" Height="30" Click="BrowseTtsModelButton_Click"
                                    Style="{StaticResource ThemedButtonStyle}"/>
                        </Grid>

                        <!-- TTS Voice Selection -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Voice" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox Grid.Column="1" Name="TtsVoiceComboBox" Height="30"
                                      Style="{StaticResource ThemedComboBoxStyle}"
                                      SelectionChanged="TtsVoiceComboBox_SelectionChanged"/>
                        </Grid>

                        <!-- Execution Mode -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Execution" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox Grid.Column="1" Name="ExecutionModeComboBox" Height="30"
                                      Style="{StaticResource ThemedComboBoxStyle}"
                                      SelectionChanged="ExecutionModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="CPU" Tag="CPU"/>
                                <ComboBoxItem Content="GPU (CUDA)" Tag="GPU"/>
                            </ComboBox>
                        </Grid>

                        <!-- TTS Output Device -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Output Device" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox Grid.Column="1" Name="TtsOutputDeviceComboBox" Height="30"
                                      Style="{StaticResource ThemedComboBoxStyle}"/>
                        </Grid>

                        <!-- Local TTS Volume -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Local Volume" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <Slider Grid.Column="1" Name="LocalVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Name="LocalVolumeValueText" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>

                        <!-- Discord TTS Volume -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Discord Volume" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <Slider Grid.Column="1" Name="DiscordVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Name="DiscordVolumeValueText" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>

                        <!-- TTS Speed -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Speed" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <Slider Grid.Column="1" Name="TtsSpeedSlider" Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Name="TtsSpeedValueText" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>

                        <!-- Voice Test -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Test" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Column="1" Name="TestPhraseTextBox" Margin="0,0,8,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="30"
                                     VerticalContentAlignment="Center" Text="Hello, this is a test."/>
                            <Button Grid.Column="2" Name="TestVoiceButton" Content="Play" 
                                    Width="80" Height="30" Click="TestVoiceButton_Click"
                                    Style="{StaticResource ThemedButtonStyle}"/>
                        </Grid>

                        <!-- Advanced TTS (Collapsed by default) -->
                        <Expander Header="Advanced TTS Settings" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <!-- Trim Silence Threshold -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Trim Threshold" VerticalAlignment="Center" 
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <Slider Grid.Column="1" Name="TrimSilenceThresholdSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Name="TrimSilenceThresholdValueText" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                </Grid>

                                <!-- Trim Leave (ms) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Trim Leave (ms)" VerticalAlignment="Center" 
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <Slider Grid.Column="1" Name="TtsTrimLeaveSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Name="TtsTrimLeaveValueText" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                </Grid>

                                <!-- Trim Max (ms) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Trim Max (ms)" VerticalAlignment="Center" 
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <Slider Grid.Column="1" Name="TtsTrimMaxSlider" Minimum="50" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Name="TtsTrimMaxValueText" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                </Grid>

                                <!-- Padding (ms) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Clause Padding (ms)" VerticalAlignment="Center" 
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <Slider Grid.Column="1" Name="TtsPaddingSlider" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="2" Name="TtsPaddingValueText" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                </Grid>

                                <!-- IPA Timeouts -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="IPA Timeouts (ms)" VerticalAlignment="Center" 
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBox Grid.Column="1" Name="TtsIpaServiceTimeoutTextBox" Height="30" Margin="0,0,8,0" Style="{StaticResource ThemedTextBoxStyle}" ToolTip="Service timeout"/>
                                    <TextBox Grid.Column="2" Name="TtsIpaOneShotTimeoutTextBox" Height="30" Margin="0,0,8,0" Style="{StaticResource ThemedTextBoxStyle}" ToolTip="One-shot fallback timeout"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- STT Settings -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="0" 
                        Background="{DynamicResource WindowBackground}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Speech-to-Text (STT)" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- STT Model Path -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vosk Model Folder" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Column="1" Name="SttModelPathTextBox" Margin="0,0,8,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="30"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Name="BrowseSttModelButton" Content="Browse" 
                                    Width="80" Height="30" Click="BrowseSttModelButton_Click"
                                    Style="{StaticResource ThemedButtonStyle}"/>
                        </Grid>

                        <!-- Microphone Input Device -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Microphone" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <ComboBox Grid.Column="1" Name="MicInputComboBox" Height="30"
                                      Style="{StaticResource ThemedComboBoxStyle}"
                                      SelectionChanged="MicInputComboBox_SelectionChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Voice Activity Detection -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="0" 
                        Background="{DynamicResource WindowBackground}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Voice Activity Detection (VAD)" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- Voice Threshold -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Voice Threshold (0–10000)" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Column="1" Name="AudioVoiceThresholdTextBox" Margin="0,0,8,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="30"
                                     ToolTip="RMS level that triggers speech detection. Lower = more sensitive."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Speaker Identification -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="0" 
                        Background="{DynamicResource WindowBackground}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Speaker Identification" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

                        <!-- Speaker Model Path -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Embedding Model" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Column="1" Name="SpeakerModelPathTextBox" Margin="0,0,8,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="30"
                                     VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Name="BrowseSpeakerModelButton" Content="Browse" 
                                    Width="80" Height="30" Click="BrowseSpeakerModelButton_Click"
                                    Style="{StaticResource ThemedButtonStyle}"/>
                        </Grid>

                        <!-- Speaker Match Threshold -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Match Threshold (0–1)" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBox Grid.Column="1" Name="SpeakerMatchThresholdTextBox" Margin="0,0,8,0" 
                                     Style="{StaticResource ThemedTextBoxStyle}" Height="30"
                                     ToolTip="Minimum similarity score to identify a speaker. Higher = stricter matching."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Name="ValidateButton" Content="Validate" 
                            Width="100" Height="32" Margin="0,0,8,0" Click="ValidateButton_Click"
                            Style="{StaticResource ThemedButtonStyle}"/>
                    <Button Name="SaveButton" Content="Save" 
                            Width="100" Height="32" Margin="0,0,8,0" Click="SaveButton_Click"
                            Style="{StaticResource ThemedButtonStyle}"/>
                    <Button Name="ResetButton" Content="Defaults" 
                            Width="100" Height="32" Click="ResetButton_Click"
                            Style="{StaticResource ThemedButtonStyle}"/>
                </StackPanel>

                <!-- Status Display -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="0" 
                        Background="{DynamicResource WindowBackground}" Margin="0,12,0,0">
                    <TextBlock Name="StatusTextBlock" Text="Configure your TTS and STT settings above"
                               Padding="6" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>