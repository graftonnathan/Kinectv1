<Window x:Class="Kinectv1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kinectv1"
        Title="Kinect Face &amp; Voice Recognition" 
        Height="750" Width="900"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="False"
        ResizeMode="CanResize"
        WindowState="Normal"
        MinHeight="650" MinWidth="800"
        Background="{DynamicResource WindowBackground}"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <!-- Default to Dark Theme -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF464647"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF0078D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF107C10"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFFF8C00"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FFE74C3C"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#FF8B5CF6"/>

        <!-- Button Styles -->
        <Style x:Key="ThemedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Styles -->
        <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                    <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Styles -->
        <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton 
                                Name="ToggleButton" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Focusable="false"
                                IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border 
                                            Name="Border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="8,3,0,3" 
                                                                  Content="{Binding Path=SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding Path=SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding Path=ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding Path=SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  IsHitTestVisible="False" />
                                                <Path Grid.Column="1" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource TextPrimary}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,3,23,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Name="DropDownBorder"
                                            Background="{DynamicResource SurfaceBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,1,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained">
                                                <StackPanel.Resources>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ComboBoxItem">
                                                                    <Border Name="Border" Padding="8,4" CornerRadius="2">
                                                                        <ContentPresenter>
                                                                            <ContentPresenter.Resources>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                                                </Style>
                                                                            </ContentPresenter.Resources>
                                                                        </ContentPresenter>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsHighlighted" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </StackPanel.Resources>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar Styles -->
        <Style x:Key="ThemedProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <Grid>
                                <Rectangle x:Name="PART_Track" Fill="{DynamicResource SurfaceBackground}"/>
                                <Rectangle x:Name="PART_Indicator" 
                                          Fill="{TemplateBinding Foreground}" 
                                          HorizontalAlignment="Left"
                                          RadiusX="6" RadiusY="6"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Styles -->
        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Name="CheckBoxBorder" 
                                    Width="16" Height="16" 
                                    Background="{DynamicResource SurfaceBackground}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,0,8,0">
                                <Path Name="CheckMark" 
                                      Data="M 2 6 L 6 10 L 14 2" 
                                      Stroke="{DynamicResource AccentGreen}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                            </Border>

                            <ContentPresenter Grid.Column="1" 
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Theme Toggle Button -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Name="ThemeToggleButton" Content="☀ Light Mode" 
                    Style="{StaticResource ThemedButtonStyle}" 
                    Background="{DynamicResource SurfaceBackgroundLight}"
                    Padding="8,4" Click="ThemeToggleButton_Click" 
                    ToolTip="Switch between light and dark theme"/>
        </StackPanel>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1" Name="MainTabControl" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="{DynamicResource SurfaceBackground}" 
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0" 
                                        CornerRadius="4,4,0,0" Margin="0,0,2,0" Padding="12,8">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" 
                                                      HorizontalAlignment="Center" ContentSource="Header" 
                                                      Margin="0" RecognizesAccessKey="True">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Main Application Tab -->
            <TabItem Header="🎤 Main Application">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

        <!-- Voice Transcription Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Voice Transcription:" FontWeight="Bold" FontSize="14" 
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" 
                    Background="{DynamicResource SurfaceBackground}">
                <Label Name="TranscriptionLabel" Content="Waiting for voice..." 
                       Background="Transparent" Foreground="{DynamicResource TextSecondary}"
                       Padding="10" MinHeight="40" FontSize="12"/>
            </Border>
        </StackPanel>

        <!-- Audio Level Display -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Audio Levels:" FontWeight="Bold" FontSize="14" 
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>

            <!-- Audio Input Controls -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Audio Sources:" FontWeight="SemiBold" FontSize="12" 
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox Name="MicInputEnabledCheckBox" Content="🎤 Mic" 
                              IsChecked="True" FontSize="11" FontWeight="Medium"
                              Foreground="{DynamicResource TextPrimary}" 
                              Style="{StaticResource ThemedCheckBoxStyle}"
                              Margin="0,0,15,0" VerticalAlignment="Center"
                              Checked="MicInputEnabledCheckBox_Checked" 
                              Unchecked="MicInputEnabledCheckBox_Unchecked"
                              ToolTip="Enable/disable microphone audio input processing"/>

                    <CheckBox Name="DiscordInputEnabledCheckBox" Content="🤖 Discord" 
                              IsChecked="True" FontSize="11" FontWeight="Medium"
                              Foreground="{DynamicResource TextPrimary}" 
                              Style="{StaticResource ThemedCheckBoxStyle}"
                              Margin="0,0,15,0" VerticalAlignment="Center"
                              Checked="DiscordInputEnabledCheckBox_Checked" 
                              Unchecked="DiscordInputEnabledCheckBox_Unchecked"
                              ToolTip="Enable/disable Discord audio input processing"/>

                    <CheckBox Name="MumbleInputEnabledCheckBox" Content="🗣️ Mumble" 
                              IsChecked="False" FontSize="11" FontWeight="Medium"
                              Foreground="{DynamicResource TextPrimary}" 
                              Style="{StaticResource ThemedCheckBoxStyle}"
                              VerticalAlignment="Center"
                              Checked="MumbleInputEnabledCheckBox_Checked" 
                              Unchecked="MumbleInputEnabledCheckBox_Unchecked"
                              ToolTip="Select Mumble as the audio source (single choice with Mic/Discord)"/>
                </StackPanel>
            </Grid>

            <!-- Microphone RMS -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🎤 Mic:" VerticalAlignment="Center" 
                           FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                <Grid Grid.Column="1">
                    <ProgressBar Name="RmsBar" Height="25" Minimum="0" Maximum="100" Value="0" 
                                 Style="{StaticResource ThemedProgressBarStyle}"
                                 Foreground="{DynamicResource AccentGreen}"/>
                    <TextBlock Name="RmsText" Text="RMS: 0.0" HorizontalAlignment="Center" 
                               VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Grid>
            </Grid>

            <!-- Discord RMS -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="19"/>
                    <ColumnDefinition Width="61"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🤖 Discord:" VerticalAlignment="Center" 
                           FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" Grid.ColumnSpan="2"/>
                <Grid Grid.Column="2">
                    <ProgressBar Name="DiscordRmsBar" Height="25" Minimum="0" Maximum="100" Value="0" 
                                 Style="{StaticResource ThemedProgressBarStyle}"
                                 Foreground="{DynamicResource AccentBlue}"/>
                    <TextBlock Name="DiscordRmsText" Text="RMS: 0.0" HorizontalAlignment="Center" 
                               VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Grid>
            </Grid>

            <!-- Mumble RMS -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🗣️ Mumble:" VerticalAlignment="Center" 
                           FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" Grid.ColumnSpan="2"/>
                <Grid Grid.Column="2">
                    <ProgressBar Name="MumbleRmsBar" Height="25" Minimum="0" Maximum="100" Value="0" 
                                 Style="{StaticResource ThemedProgressBarStyle}"
                                 Foreground="{DynamicResource AccentPurple}"/>
                    <TextBlock Name="MumbleRmsText" Text="RMS: 0.0" HorizontalAlignment="Center" 
                               VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </Grid>
            </Grid>
        </StackPanel>

        <!-- Speaker Recognition -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Speaker Recognition:" FontWeight="Bold" FontSize="14" 
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
            <Border BorderBrush="{DynamicResource AccentBlue}" BorderThickness="1" CornerRadius="4"
                    Background="{DynamicResource SurfaceBackground}">
                <Label Name="SpeakerLabel" Content="Unknown (0.00)" 
                       Background="Transparent" Foreground="{DynamicResource TextSecondary}"
                       Padding="10" MinHeight="35" FontSize="12"/>
            </Border>
        </StackPanel>

        <!-- Enrollment Section - Unified Row -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Enrollment:" FontWeight="Bold" FontSize="14" 
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

            <!-- Name Input and Buttons Row -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" 
                           FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Name="EnrollNameBox" Height="35" 
                         Style="{StaticResource ThemedTextBoxStyle}"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="3" Name="EnrollFaceButton" Content="👤 Enroll Face" 
                        Height="30" Padding="8" Click="EnrollButton_Click"
                        Style="{StaticResource ThemedButtonStyle}"
                        Background="{DynamicResource AccentBlue}"/>

                <Button Grid.Column="5" Name="EnrollVoiceButton" Content="🎙 Enroll Voice" 
                        Height="30" Padding="8" Click="EnrollVoiceButton_Click"
                        Style="{StaticResource ThemedButtonStyle}"
                        Background="{DynamicResource AccentGreen}"/>
            </Grid>

            <!-- Voice Enrollment Progress -->
            <StackPanel Name="VoiceEnrollmentPanel" Visibility="Collapsed" Margin="0,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Name="VoiceEnrollStatusText" Text="Ready for voice enrollment" 
                                   VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <ProgressBar Name="VoiceEnrollProgress" Width="200" Height="18" 
                                     Minimum="0" Maximum="10" Value="0" Margin="0,0,10,0"
                                     Style="{StaticResource ThemedProgressBarStyle}"
                                     Foreground="{DynamicResource AccentGreen}"/>
                        <TextBlock Name="VoiceProgressText" Text="0/10" VerticalAlignment="Center" 
                                   FontSize="11" Width="30" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Name="VoiceProgressPercent" Text="(0%)" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource AccentBlue}" FontWeight="Bold" FontSize="11" Margin="5,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Name="CancelVoiceButton" Content="Cancel" 
                            Width="60" Height="25" Click="CancelVoiceButton_Click" 
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentRed}" FontSize="10"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Control Buttons Row -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Name="ShowVideoButton" Content="📺 Show Video" Padding="10,6" 
                    Click="ShowVideoButton_Click" Style="{StaticResource ThemedButtonStyle}"
                    Background="{DynamicResource AccentPurple}" Margin="0,0,15,0"/>
                    
            <Button Name="ListSpeakersButton" Content="📋 List Speakers" Padding="10,6" 
                    Click="ListSpeakersButton_Click" Style="{StaticResource ThemedButtonStyle}"
                    Background="{DynamicResource SurfaceBackgroundLight}" Margin="0,0,15,0"/>

            <Button Name="FlushVoiceButton" Content="🗑 Clear Voice Data" Padding="10,6" 
                    Click="FlushVoiceButton_Click" Style="{StaticResource ThemedButtonStyle}"
                    Background="{DynamicResource AccentRed}"/>
        </StackPanel>

        <!-- Status Display -->
        <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" 
                Margin="0,0,0,10" Background="{DynamicResource SurfaceBackground}">
            <TextBlock Text="Application ready - Enhanced face and voice recognition active!" 
                       Padding="10" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}" FontSize="12"/>
        </Border>

        <!-- Ollama AI Section -->
        <Border Grid.Row="6" BorderBrush="{DynamicResource AccentBlue}" BorderThickness="2" CornerRadius="6" 
                Background="{DynamicResource SurfaceBackground}">
            <StackPanel Margin="15">
                <Grid Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Name="ToggleOllamaButton" Content="Enable Ollama" 
                            Padding="10,5" Click="ToggleOllamaButton_Click" 
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentGreen}"/>

                    <ComboBox Grid.Column="2" Name="OllamaModelComboBox" Height="30" 
                              SelectionChanged="OllamaModelComboBox_SelectionChanged"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              ToolTip="Select AI model for voice responses"/>

                    <Button Grid.Column="4" Name="RefreshModelsButton" Content="??" 
                            Width="30" Height="30" Click="RefreshModelsButton_Click"
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource SurfaceBackgroundLight}"
                            ToolTip="Refresh available models from Ollama server"
                            FontSize="12"/>
                </Grid>

                <TextBlock Text="AI Response:" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                        Background="{DynamicResource WindowBackground}">
                    <TextBox Name="OllamaResponseBox" Height="200" TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" IsReadOnly="True" 
                             Background="Transparent" BorderThickness="0" Padding="10" FontSize="11"
                             Foreground="{DynamicResource TextSecondary}"
                             Style="{StaticResource ThemedTextBoxStyle}"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Name="OllamaStatusText" Text="?? Ollama: Ready" VerticalAlignment="Center" 
                               Foreground="{DynamicResource AccentBlue}" FontStyle="Italic" FontSize="11" Margin="0,0,15,0"/>
                    <TextBlock Text="Speak to send your voice to the AI!" VerticalAlignment="Center" 
                               Foreground="{DynamicResource AccentGreen}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- TTS (Text-to-Speech) Section - New Addition -->
        <Border Grid.Row="7" BorderBrush="{DynamicResource AccentOrange}" BorderThickness="2" CornerRadius="6" 
                Background="{DynamicResource SurfaceBackground}" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel Margin="15">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Name="ToggleTtsButton" Content="Enable TTS" 
                            Padding="10,5" Click="ToggleTtsButton_Click" 
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentGreen}"/>

                    <ComboBox Grid.Column="2" Name="TtsModelComboBox" Height="30" 
                              SelectionChanged="TtsModelComboBox_SelectionChanged"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              ToolTip="Select TTS model"/>

                    <ComboBox Grid.Column="4" Name="TtsSpeakerComboBox" Height="30" 
                              SelectionChanged="TtsSpeakerComboBox_SelectionChanged"
                              Style="{StaticResource ThemedComboBoxStyle}"
                              ToolTip="Select TTS voice/speaker"/>

                    <Button Grid.Column="6" Name="TestTtsButton" Content="🔊 Test" 
                            Width="60" Height="30" Click="TestTtsButton_Click"
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentOrange}"
                            ToolTip="Test text-to-speech"/>

                    <Button Grid.Column="8" Name="TtsGpuToggleButton" Content="⚡ GPU" 
                            Width="65" Height="30" Click="TtsGpuToggleButton_Click"
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentPurple}"
                            ToolTip="Toggle between GPU and CPU processing"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Model:" FontWeight="Bold" FontSize="12" 
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Name="TtsModelStatusText" Text="Loading models..." 
                               FontSize="11" Foreground="{DynamicResource TextSecondary}" 
                               VerticalAlignment="Center" Margin="10,0,10,0"/>
                    <Button Grid.Column="2" Name="RefreshTtsModelsButton" Content="🔄 Refresh" 
                            Height="25" Padding="8,2" Click="RefreshTtsModelsButton_Click"
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource SurfaceBackgroundLight}"
                            ToolTip="Refresh available TTS models" FontSize="10"/>
                </Grid>

                <TextBlock Text="TTS Test Text:" FontWeight="Bold" FontSize="12" 
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                <TextBox Name="TtsTestTextBox" Height="45" TextWrapping="NoWrap" 
                         Text="Hello, this is a test of the text to speech system."
                         Style="{StaticResource ThemedTextBoxStyle}"
                         VerticalContentAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Name="TtsStatusText" Text="?? TTS: Disabled" VerticalAlignment="Center" 
                               Foreground="{DynamicResource AccentOrange}" FontStyle="Italic" FontSize="11" Margin="0,0,15,0"/>
                    <TextBlock Text="AI responses will be spoken when TTS is enabled!" VerticalAlignment="Center" 
                               Foreground="{DynamicResource AccentGreen}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="⚙ Settings">
                <Grid Margin="10">
                    <ContentControl x:Name="SettingsHost"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Shutdown overlay (initially hidden) -->
        <Grid Name="ShutdownOverlay" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="999">
            <Border Background="{DynamicResource SurfaceBackground}" 
                    BorderBrush="{DynamicResource AccentBlue}" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Padding="40">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <!-- Animated spinner -->
                    <Border Width="48" Height="48" Margin="0,0,0,20">
                        <Ellipse Width="48" Height="48" 
                                 Stroke="{DynamicResource AccentBlue}" 
                                 StrokeThickness="4" 
                                 StrokeDashArray="25,25" 
                                 StrokeDashOffset="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                           Storyboard.TargetProperty="Angle"
                                                           From="0" To="360" Duration="0:0:1"
                                                           RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Border>
                    
                    <TextBlock Name="ShutdownStatusText" 
                               Text="Shutting down services..." 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,10"/>
                    
                    <TextBlock Name="ShutdownDetailText" 
                               Text="Please wait while all services are stopped safely..."
                               FontSize="12" 
                               Foreground="{DynamicResource TextSecondary}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
