<Window x:Class="Kinectv1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kinectv1"
        Title="Voice AI Assistant" 
        Height="700" Width="850"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="False"
        ResizeMode="CanResize"
        WindowState="Normal"
        MinHeight="600" MinWidth="750"
        Background="{DynamicResource WindowBackground}"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <!-- Dark Theme -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF121212"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#FF2A2A2A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFB0B0B0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FF707070"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF3B82F6"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF22C55E"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFF59E0B"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FFEF4444"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#FF8B5CF6"/>

        <!-- Compact Button Style -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim Progress Bar -->
        <Style x:Key="SlimProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Grid x:Name="TemplateRoot">
                                <Rectangle x:Name="PART_Track" Opacity="0"/>
                                <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Rectangle x:Name="Indicator" Fill="{TemplateBinding Foreground}" RadiusX="4" RadiusY="4"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Modern CheckBox -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{DynamicResource SurfaceBackgroundLight}" 
                                CornerRadius="6" Padding="8,6" Name="Bg">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14" Height="14" CornerRadius="3" 
                                        Background="{DynamicResource SurfaceBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="1" Name="Box" Margin="0,0,6,0">
                                    <Path Data="M2,5 L5,8 L10,2" Stroke="{DynamicResource AccentGreen}" 
                                          StrokeThickness="2" Name="Check" Visibility="Collapsed"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                                <Setter TargetName="Bg" Property="Background" Value="#FF1A2E1A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="Transparent" 
                                CornerRadius="6" Margin="0,0,4,0" Padding="14,8">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SurfaceBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Voice AI" FontSize="18" FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
            <Button Name="ThemeToggleButton" Content="☀️" 
                    Style="{StaticResource IconButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="ThemeToggleButton_Click" 
                    ToolTip="Toggle theme"/>
        </Grid>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            
            <!-- Main Tab -->
            <TabItem Header="🎤 Assistant">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                    <StackPanel>
                        
                        <!-- Audio Sources Row -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Input" FontWeight="SemiBold" FontSize="11" 
                                           Foreground="{DynamicResource TextMuted}" 
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox Name="MicInputEnabledCheckBox" Content="🎤 Mic" 
                                              IsChecked="True" Style="{StaticResource ModernCheckBoxStyle}"
                                              Margin="0,0,6,0"
                                              Checked="MicInputEnabledCheckBox_Checked" 
                                              Unchecked="MicInputEnabledCheckBox_Unchecked"/>
                                    <CheckBox Name="DiscordInputEnabledCheckBox" Content="💬 Discord" 
                                              Style="{StaticResource ModernCheckBoxStyle}"
                                              Margin="0,0,6,0"
                                              Checked="DiscordInputEnabledCheckBox_Checked" 
                                              Unchecked="DiscordInputEnabledCheckBox_Unchecked"/>
                                    <CheckBox Name="WebRtcInputEnabledCheckBox" Content="📱 WebRTC" 
                                              Style="{StaticResource ModernCheckBoxStyle}"
                                              Checked="WebRtcInputEnabledCheckBox_Checked" 
                                              Unchecked="WebRtcInputEnabledCheckBox_Unchecked"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Combined Audio Level -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="45"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="ActiveSourceLabel" Text="🎤 Mic" FontSize="12" 
                                           Foreground="{DynamicResource TextSecondary}" 
                                           VerticalAlignment="Center"/>
                                <ProgressBar Name="RmsBar" Grid.Column="1" 
                                             Style="{StaticResource SlimProgressBarStyle}"
                                             Foreground="{DynamicResource AccentGreen}" Maximum="100"
                                             Height="8"/>
                                <TextBlock Name="RmsText" Grid.Column="2" Text="0%" FontSize="12" 
                                           Foreground="{DynamicResource TextMuted}" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Transcription & Speaker -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TRANSCRIPTION" FontWeight="SemiBold" FontSize="10" 
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBackgroundLight}" 
                                            CornerRadius="4" Padding="8,2">
                                        <Label Name="SpeakerLabel" Content="Unknown" FontSize="11" Padding="0"
                                               Foreground="{DynamicResource TextSecondary}" Background="Transparent"/>
                                    </Border>
                                </Grid>
                                <!-- Partial (live) transcription -->
                                <Label Name="PartialTranscriptionLabel" Content="" 
                                       FontSize="12" FontStyle="Italic"
                                       Foreground="{DynamicResource TextMuted}"
                                       Background="Transparent" Padding="0" MinHeight="20"/>
                                <!-- Final transcription -->
                                <Label Name="TranscriptionLabel" Content="Listening..." 
                                       FontSize="14" Foreground="{DynamicResource TextPrimary}"
                                       Background="Transparent" Padding="0" MinHeight="24"/>
                            </StackPanel>
                        </Border>

                        <!-- AI Chat -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="AI CONVERSATION" FontWeight="SemiBold" FontSize="10" 
                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                
                                <!-- Response Area -->
                                <Border Background="{DynamicResource WindowBackground}" 
                                        CornerRadius="6" Margin="0,0,0,8">
                                    <TextBox Name="OllamaResponseBox" Height="160" TextWrapping="Wrap" 
                                             VerticalScrollBarVisibility="Auto" IsReadOnly="True" 
                                             Background="Transparent" BorderThickness="0" 
                                             Padding="10" FontSize="13"
                                             Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                                
                                <!-- Input -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="TextInputBox" Style="{StaticResource ModernTextBoxStyle}"
                                             KeyDown="TextInputBox_KeyDown"/>
                                    <Button Grid.Column="2" Name="SendTextButton" Content="Send" 
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="16,8" Click="SendTextButton_Click"/>
                                </Grid>
                                
                                <!-- Status -->
                                <TextBlock Name="OllamaStatusText" Text="Ready" FontSize="11" 
                                           Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Voice Enrollment -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="VOICE ENROLLMENT" FontWeight="SemiBold" FontSize="10" 
                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Name="EnrollNameBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                    <Button Grid.Column="2" Name="EnrollVoiceButton" Content="Enroll" 
                                            Style="{StaticResource CompactButtonStyle}"
                                            Background="{DynamicResource AccentGreen}"
                                            Padding="12,8" Click="EnrollVoiceButton_Click"/>
                                    <Button Grid.Column="4" Name="ListSpeakersButton" Content="List" 
                                            Style="{StaticResource CompactButtonStyle}"
                                            Padding="12,8" Click="ListSpeakersButton_Click"/>
                                    <Button Grid.Column="6" Name="FlushVoiceButton" Content="Clear" 
                                            Style="{StaticResource CompactButtonStyle}"
                                            Background="{DynamicResource AccentRed}"
                                            Padding="12,8" Click="FlushVoiceButton_Click"/>
                                </Grid>
                                
                                <!-- Enrollment Progress -->
                                <StackPanel Name="VoiceEnrollmentPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Name="VoiceEnrollProgress" Style="{StaticResource SlimProgressBarStyle}"
                                                     Height="8" Foreground="{DynamicResource AccentGreen}" 
                                                     Maximum="10" VerticalAlignment="Center"/>
                                        <TextBlock Name="VoiceProgressText" Grid.Column="1" Text="0/10" 
                                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Name="VoiceProgressPercent" Grid.Column="1" Visibility="Collapsed"/>
                                        <TextBlock Name="VoiceEnrollStatusText" Visibility="Collapsed"/>
                                        <Button Grid.Column="3" Name="CancelVoiceButton" Content="✕" 
                                                Style="{StaticResource IconButtonStyle}"
                                                Background="{DynamicResource AccentRed}"
                                                Click="CancelVoiceButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="⚙️ Settings">
                <Grid Margin="0,8,0,0">
                    <ContentControl x:Name="SettingsHost"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Shutdown Overlay -->
        <Grid Name="ShutdownOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="999">
            <Border Background="{DynamicResource SurfaceBackground}" 
                    CornerRadius="12" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="40" Height="40" Margin="0,0,0,16">
                        <Ellipse Width="40" Height="40" 
                                 Stroke="{DynamicResource AccentBlue}" 
                                 StrokeThickness="3" 
                                 StrokeDashArray="20,20"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                           Storyboard.TargetProperty="Angle"
                                                           From="0" To="360" Duration="0:0:1"
                                                           RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Border>
                    <TextBlock Name="ShutdownStatusText" Text="Shutting down..." 
                               FontSize="14" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Name="ShutdownDetailText" Text="Please wait"
                               FontSize="12" Foreground="{DynamicResource TextMuted}" 
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
