<Window x:Class="Kinectv1.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="600"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <!-- Use same theme resources as MainWindow -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF464647"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FFB0B0B0"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF0078D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF107C10"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FFE74C3C"/>
    </Window.Resources>

    <DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: TreeView for Categories -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <TreeView Name="CategoriesTreeView"
                          Background="{DynamicResource SurfaceBackground}"
                          Foreground="{DynamicResource TextPrimary}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          ItemsSource="{Binding Categories}"
                          SelectedItemChanged="CategoriesTreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" 
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Right Panel: ContentPresenter for Settings -->
            <Border Grid.Column="2"
                    Background="{DynamicResource WindowBackground}"
                    Padding="20">
                <ContentPresenter Content="{Binding SelectedCategory.EditorView}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
