<UserControl x:Class="Kinectv1.UI.Settings.DebugSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="600">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF464647"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FF999999"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF107C10"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFFF8C00"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FFE74C3C"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF3B82F6"/>
        <SolidColorBrush x:Key="MeterBackground" Color="#FF1A1A1A"/>
        <Style x:Key="ThemedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Debug Settings" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <!-- Audio Level Meter -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Audio Input Level" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                        
                        <!-- RMS Level Bar -->
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="RMS Level:" Foreground="{DynamicResource TextMuted}" FontSize="12" Width="80"/>
                                <TextBlock x:Name="RmsValueText" Text="0" Foreground="{DynamicResource TextSecondary}" FontSize="12" Width="60"/>
                                <TextBlock Text="Peak:" Foreground="{DynamicResource TextMuted}" FontSize="12" Width="40" Margin="10,0,0,0"/>
                                <TextBlock x:Name="PeakValueText" Text="0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                            </StackPanel>
                            <Grid Height="24" Background="{DynamicResource MeterBackground}" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="RmsLevelBar" HorizontalAlignment="Left" Fill="#FF107C10" Height="20" Width="0" Margin="2"/>
                                <Rectangle x:Name="PeakIndicator" HorizontalAlignment="Left" Fill="#FFFF8C00" Width="3" Height="20" Margin="2" Opacity="0.8"/>
                                <!-- Scale markers -->
                                <Canvas>
                                    <Line X1="100" Y1="0" X2="100" Y2="24" Stroke="#FF464647" StrokeThickness="1" Opacity="0.5"/>
                                    <Line X1="200" Y1="0" X2="200" Y2="24" Stroke="#FF464647" StrokeThickness="1" Opacity="0.5"/>
                                    <Line X1="300" Y1="0" X2="300" Y2="24" Stroke="#FF464647" StrokeThickness="1" Opacity="0.5"/>
                                    <Line X1="400" Y1="0" X2="400" Y2="24" Stroke="#FFFF8C00" StrokeThickness="1" Opacity="0.7"/>
                                </Canvas>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="0" Foreground="{DynamicResource TextMuted}" FontSize="9" Width="100"/>
                                <TextBlock Text="1000" Foreground="{DynamicResource TextMuted}" FontSize="9" Width="100"/>
                                <TextBlock Text="2000" Foreground="{DynamicResource TextMuted}" FontSize="9" Width="100"/>
                                <TextBlock Text="3000" Foreground="{DynamicResource TextMuted}" FontSize="9" Width="100"/>
                                <TextBlock Text="4000+" Foreground="#FFFF8C00" FontSize="9"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- VAD Status -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="VAD Threshold:" Foreground="{DynamicResource TextMuted}" FontSize="12" Width="100"/>
                            <TextBlock x:Name="VadThresholdText" Text="--" Foreground="{DynamicResource TextSecondary}" FontSize="12" Width="80"/>
                            <TextBlock Text="Status:" Foreground="{DynamicResource TextMuted}" FontSize="12" Width="50" Margin="10,0,0,0"/>
                            <TextBlock x:Name="VadStatusText" Text="--" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </StackPanel>

                        <Button Content="Reset Peak" Margin="0,12,0,0" Style="{StaticResource ThemedButtonStyle}" Click="ResetPeakButton_Click" HorizontalAlignment="Left" Width="100"/>
                    </StackPanel>
                </Border>

                <!-- VAD Diagnostics Section (NEW) -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="VAD Diagnostics" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,12"
                                   Text="Tools to diagnose Voice Activity Detection issues. Enable RMS logging to see actual audio levels vs thresholds in the console."/>
                        <!-- RMS Logging Toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="RMS Console Logging" Foreground="{DynamicResource TextSecondary}" Width="150" VerticalAlignment="Center"/>
                            <CheckBox x:Name="RmsLoggingCheckBox" Style="{StaticResource ThemedCheckBoxStyle}" 
                                      ToolTip="Log peak RMS values to console every second. Helps diagnose if VAD threshold is too high."
                                      Checked="RmsLoggingCheckBox_Changed" Unchecked="RmsLoggingCheckBox_Changed"/>
                            <TextBlock x:Name="RmsLoggingStatusText" Text="Off" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- VAD Bypass Toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Bypass VAD (Test)" Foreground="{DynamicResource TextSecondary}" Width="150" VerticalAlignment="Center"/>
                            <CheckBox x:Name="VadBypassCheckBox" Style="{StaticResource ThemedCheckBoxStyle}" 
                                      ToolTip="Disable VAD gating - all audio goes directly to Vosk. Use to test if VAD is causing word drops."
                                      Checked="VadBypassCheckBox_Changed" Unchecked="VadBypassCheckBox_Changed"/>
                            <TextBlock x:Name="VadBypassStatusText" Text="VAD Active" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Diagnostics Toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Verbose Diagnostics" Foreground="{DynamicResource TextSecondary}" Width="150" VerticalAlignment="Center"/>
                            <CheckBox x:Name="VerboseDiagCheckBox" Style="{StaticResource ThemedCheckBoxStyle}" 
                                      ToolTip="Enable detailed VoiceRecognizer logging (Vosk results, partials, etc.)"
                                      Checked="VerboseDiagCheckBox_Changed" Unchecked="VerboseDiagCheckBox_Changed"/>
                            <TextBlock x:Name="VerboseDiagStatusText" Text="Off" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Current Settings Display -->
                        <Border Background="{DynamicResource SurfaceBackgroundLight}" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Current VAD Settings:" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="VadSettingsText" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="10"
                                           Text="Threshold: --, Low: --, Debounce: --ms, Silence: --ms"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="VadDiagStatusText" TextWrapping="Wrap" Foreground="{DynamicResource AccentOrange}" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"
                                   Text=""/>
                    </StackPanel>
                </Border>

                <!-- WebRTC DSP Settings -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="WebRTC Audio Processing" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,12"
                                   Text="Browser-side audio processing. Disabling these can fix choppy/hollow audio when using speakerphone, but may increase echo/noise with headphones."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Echo Cancellation" Foreground="{DynamicResource TextSecondary}" Width="150" VerticalAlignment="Center"/>
                            <CheckBox x:Name="EchoCancellationCheckBox" Style="{StaticResource ThemedCheckBoxStyle}" 
                                      ToolTip="Reduces echo from speakers. Disable if audio sounds choppy/hollow on speakerphone."
                                      Checked="WebRtcDspCheckBox_Changed" Unchecked="WebRtcDspCheckBox_Changed"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Noise Suppression" Foreground="{DynamicResource TextSecondary}" Width="150" VerticalAlignment="Center"/>
                            <CheckBox x:Name="NoiseSuppressionCheckBox" Style="{StaticResource ThemedCheckBoxStyle}" 
                                      ToolTip="Reduces background noise. Disable if speech is being cut off or sounds robotic."
                                      Checked="WebRtcDspCheckBox_Changed" Unchecked="WebRtcDspCheckBox_Changed"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Auto Gain Control" Foreground="{DynamicResource TextSecondary}" Width="150" VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoGainCheckBox" Style="{StaticResource ThemedCheckBoxStyle}" 
                                      ToolTip="Automatically adjusts microphone volume. Disable if volume is pumping/unstable."
                                      Checked="WebRtcDspCheckBox_Changed" Unchecked="WebRtcDspCheckBox_Changed"/>
                        </StackPanel>

                        <TextBlock x:Name="WebRtcDspStatusText" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,8,0,0"
                                   Text="Current URL parameter: (none)"/>
                    </StackPanel>
                </Border>

                <!-- WebRTC Server-Side Normalization -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="WebRTC Audio Processing (Server-Side)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,12"
                                   Text="Server-side audio processing for WebRTC input. Normalization boosts quiet audio for better recognition."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Enable Normalization" Foreground="{DynamicResource TextSecondary}" Width="150" VerticalAlignment="Center"/>
                            <CheckBox x:Name="NormalizationEnabledCheckBox" Style="{StaticResource ThemedCheckBoxStyle}" 
                                      ToolTip="Enable server-side audio normalization for WebRTC input. Recommended for quiet mobile microphones."
                                      Checked="NormalizationCheckBox_Changed" Unchecked="NormalizationCheckBox_Changed"/>
                            <TextBlock x:Name="NormalizationStatusText" Text="Off" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Target RMS Level" Foreground="{DynamicResource TextSecondary}" Width="150" VerticalAlignment="Center"/>
                            <TextBox x:Name="NormalizationTargetRmsTextBox" Style="{StaticResource ThemedTextBoxStyle}" Width="80"
                                     ToolTip="Target RMS level for normalized audio (500-10000). Speech typically needs 2000-4000 for good recognition. Default: 3000"/>
                            <TextBlock Text="(500-10000)" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Maximum Gain" Foreground="{DynamicResource TextSecondary}" Width="150" VerticalAlignment="Center"/>
                            <TextBox x:Name="NormalizationMaxGainTextBox" Style="{StaticResource ThemedTextBoxStyle}" Width="80"
                                     ToolTip="Maximum gain to apply (1-20x). Higher values boost quieter audio more but may amplify noise. Default: 8x"/>
                            <TextBlock Text="x (1-20)" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{DynamicResource SurfaceBackgroundLight}" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="10">
                                 <Run FontWeight="SemiBold">Normalization:</Run>
                                 <Run>Boosts quiet audio for better speech recognition.</Run>
                                 <LineBreak/>
                                 <Run>- Low target RMS (2000): Gentle boost, preserves dynamics</Run>
                                 <LineBreak/>
                                 <Run>- High target RMS (4000): Stronger boost, may sound compressed</Run>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Audio Capture -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Audio Input Capture" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,12"
                                   Text="Capture audio just before it reaches the Vosk STT engine. Uses VAD to only record when voice is detected."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Output Folder" Foreground="{DynamicResource TextSecondary}" Width="100" VerticalAlignment="Center"/>
                            <TextBox x:Name="AudioCaptureFolderTextBox" Style="{StaticResource ThemedTextBoxStyle}" Width="250"/>
                            <Button Content="Browse..." Margin="8,0,0,0" Style="{StaticResource ThemedButtonStyle}" Click="BrowseAudioFolderButton_Click"/>
                        </StackPanel>

                        <!-- Capture Status -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                            <TextBlock Text="Status:" Foreground="{DynamicResource TextMuted}" FontSize="12" Width="100"/>
                            <TextBlock x:Name="CaptureStatusText" Text="Not Active" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Frames:" Foreground="{DynamicResource TextMuted}" FontSize="12" Width="100"/>
                            <TextBlock x:Name="FrameCountText" Text="0" Foreground="{DynamicResource TextSecondary}" FontSize="12" Width="80"/>
                            <TextBlock Text="VAD:" Foreground="{DynamicResource TextMuted}" FontSize="12" Width="40"/>
                            <TextBlock x:Name="CaptureVadStatusText" Text="--" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </StackPanel>

                        <!-- Dropout diagnostics -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Zero Frames:" Foreground="{DynamicResource TextMuted}" FontSize="12" Width="100"/>
                            <TextBlock x:Name="ZeroFrameCountText" Text="0" Foreground="{DynamicResource TextSecondary}" FontSize="12" Width="80"/>
                            <TextBlock Text="(" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                            <TextBlock x:Name="ZeroFramePercentText" Text="0%" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text=" dropout)" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="File:" Foreground="{DynamicResource TextMuted}" FontSize="12" Width="100"/>
                            <TextBlock x:Name="CurrentFileText" Text="--" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="StartStopCaptureButton" Content="Start Capture" Style="{StaticResource ThemedButtonStyle}" Click="StartStopCaptureButton_Click" Width="120"/>
                            <Button Content="New File" Margin="8,0,0,0" Style="{StaticResource ThemedButtonStyle}" Click="RotateFileButton_Click" 
                                    ToolTip="Start a new capture file without stopping"/>
                            <Button Content="Open Folder" Margin="8,0,0,0" Style="{StaticResource ThemedButtonStyle}" Click="OpenFolderButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Info Box -->
                <Border Background="{DynamicResource SurfaceBackgroundLight}" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="[i] Troubleshooting Audio Issues" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="11">
                            <Run>- Words getting cut off: Enable "Bypass VAD" to test if VAD is too aggressive</Run>
                            <LineBreak/>
                            <Run>- Enable "RMS Console Logging" to see actual audio levels vs threshold</Run>
                            <LineBreak/>
                            <Run>- Hollow/choppy audio: Disable Echo Cancellation and Noise Suppression</Run>
                            <LineBreak/>
                            <Run>- High "Zero Frames %" indicates browser DSP is zeroing audio</Run>
                            <LineBreak/>
                            <Run>- Captured files: 16kHz, 16-bit mono WAV (Vosk input format)</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Style="{StaticResource ThemedButtonStyle}" Background="{DynamicResource AccentGreen}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
