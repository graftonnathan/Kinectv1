<UserControl x:Class="Kinectv1.UI.Settings.ToolsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI">
    <UserControl.Resources>
        <!-- Dark theme brushes -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF464647"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FF999999"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF0078D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF107C10"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFFF8C00"/>

        <Style x:Key="ThemedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Foreground="{DynamicResource TextPrimary}" 
                   FontSize="16" FontWeight="SemiBold" Text="LLM Tools" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Tools Enabled -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Tool Use" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enable Tools" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <CheckBox x:Name="ToolsEnabledCheckBox" Grid.Column="1" 
                                      Style="{StaticResource ThemedCheckBoxStyle}"
                                      Checked="ToolsEnabledCheckBox_Changed"
                                      Unchecked="ToolsEnabledCheckBox_Changed"/>
                        </Grid>
                        
                        <TextBlock Text="When enabled, the AI can use tools like web search to find current information."
                                   Foreground="{DynamicResource TextMuted}" FontSize="12" 
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Web Search Tool -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Web Search" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                        
                        <TextBlock Text="Searches the web using DuckDuckGo, fetches article content, and provides it to the AI for summarization."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" 
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Status:" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                            <TextBlock x:Name="WebSearchStatusText" Grid.Column="1" 
                                       Text="Available" Foreground="{DynamicResource AccentGreen}" FontSize="12"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Provider:" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="DuckDuckGo (no API key required)" 
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Features:" VerticalAlignment="Top" 
                                       Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="- Fetches up to 3 articles" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="- Extracts main content (removes ads, navigation)" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="- Provides source URLs for citations" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Test Search -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" 
                                Margin="0,12,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Test Search" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TestSearchQueryTextBox" 
                                             Background="{DynamicResource SurfaceBackgroundLight}"
                                             Foreground="{DynamicResource TextPrimary}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             Padding="8,6" VerticalContentAlignment="Center"
                                             Text="latest AI news"/>
                                    <Button x:Name="TestSearchButton" Grid.Column="1" 
                                            Content="Test" Width="80" Margin="8,0,0,0"
                                            Style="{StaticResource ThemedButtonStyle}"
                                            Click="TestSearchButton_Click"/>
                                </Grid>
                                <TextBlock x:Name="TestSearchResultText" 
                                           Foreground="{DynamicResource TextMuted}" FontSize="11" 
                                           TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="100"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Future Tools Placeholder -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Coming Soon" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                        
                        <StackPanel>
                            <TextBlock Text="- Weather: Get current weather conditions" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                            <TextBlock Text="- Calculator: Solve complex math expressions" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                            <TextBlock Text="- Wikipedia: Direct knowledge base access" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- How It Works -->
                <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="How Tools Work" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                        
                        <StackPanel>
                            <TextBlock Text="1. You ask a question the AI needs current info for" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text="2. AI decides to use a tool (e.g., web search)" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text="3. Tool executes and returns results" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text="4. AI summarizes the results in its response" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
                        </StackPanel>
                        
                        <TextBlock Text="Example: 'What's the latest news about AI regulations?'"
                                   Foreground="{DynamicResource TextMuted}" FontSize="11" 
                                   FontStyle="Italic" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" 
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Style="{StaticResource ThemedButtonStyle}" 
                    Background="{DynamicResource AccentGreen}" 
                    Click="SaveButton_Click" Content="Save"/>
        </StackPanel>
    </Grid>
</UserControl>
