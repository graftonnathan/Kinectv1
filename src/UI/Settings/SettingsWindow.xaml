<Window x:Class="Kinectv1.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="600"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <!-- Use same theme resources as MainWindow -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF464647"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#FFB0B0B0"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF0078D4"/>
        
        <!-- TreeView Style -->
        <Style x:Key="SettingsTreeViewStyle" TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <!-- TreeViewItem Style -->
        <Style x:Key="SettingsTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Header}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: TreeView for Categories -->
        <Border Grid.Column="0" 
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <TreeView Name="CategoriesTreeView"
                      Style="{StaticResource SettingsTreeViewStyle}"
                      ItemsSource="{Binding Categories}"
                      SelectedItemChanged="CategoriesTreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" 
                                   Style="{StaticResource SettingsTreeViewItemStyle}"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" 
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- Right Panel: ContentPresenter for Settings -->
        <Border Grid.Column="2"
                Background="{DynamicResource WindowBackground}"
                Padding="20">
            <ContentPresenter Content="{Binding SelectedCategory.EditorView}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Top">
                <ContentPresenter.ContentTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBackground}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="20">
                            <StackPanel>
                                <TextBlock Text="{Binding CategoryName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ContentPresenter.ContentTemplate>
            </ContentPresenter>
        </Border>
    </Grid>
</Window>