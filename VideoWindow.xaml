<!-- VideoWindow.xaml -->
<Window x:Class="Kinectv1.VideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Video Feed - Face Recognition" 
        Height="520" Width="680"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="False"
        ResizeMode="CanResize"
        WindowState="Normal"
        Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Video Display Area -->
        <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both">
            <Canvas Name="VideoCanvas" Width="1920" Height="1080" Background="Black">
                <!-- Main video feed -->
                <Image Name="VideoImage" 
                       Canvas.Left="0" Canvas.Top="0"
                       Width="1920" Height="1080"
                       Stretch="Fill"/>
                
                <!-- Overlay canvas for face rectangles and labels -->
                <Canvas Name="OverlayCanvas" 
                        Canvas.Left="0" Canvas.Top="0"
                        Width="1920" Height="1080"
                        Background="Transparent"/>
            </Canvas>
        </Viewbox>
        
        <!-- Status Bar -->
        <Border Grid.Row="1" Background="DarkGray" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="StatusText" Text="Initializing video feed..." 
                           Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" | " Foreground="LightGray" Margin="10,0"/>
                <TextBlock Name="FpsText" Text="FPS: 0" 
                           Foreground="LightGreen" VerticalAlignment="Center"/>
                <TextBlock Text=" | " Foreground="LightGray" Margin="10,0"/>
                <TextBlock Name="FaceCountText" Text="Faces: 0" 
                           Foreground="LightBlue" VerticalAlignment="Center"/>
                <TextBlock Text=" | " Foreground="LightGray" Margin="10,0"/>
                <TextBlock Name="ResolutionText" Text="Resolution: 1920x1080" 
                           Foreground="LightGray" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>