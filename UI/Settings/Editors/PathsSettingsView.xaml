<UserControl x:Class="Kinectv1.UI.Settings.Editors.PathsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    
    <UserControl.Resources>
        <!-- Inherit theme resources from MainWindow -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="SurfaceBackgroundLight" Color="#FF3F3F46"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF464647"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF0078D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF107C10"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FFFF8C00"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FFE74C3C"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFFDD835"/>

        <!-- Button Style -->
        <Style x:Key="ThemedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ThemedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="5" 
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Name="CheckBoxBorder" 
                                    Width="16" Height="16" 
                                    Background="{DynamicResource SurfaceBackground}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,0,8,0">
                                <Path Name="CheckMark" 
                                      Data="M 2 6 L 6 10 L 14 2" 
                                      Stroke="{DynamicResource AccentGreen}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                            </Border>

                            <ContentPresenter Grid.Column="1" 
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource SurfaceBackgroundLight}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBackground}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="📁 Path Settings" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimary}" 
                           Margin="0,0,0,20"/>

                <!-- Path Type Toggle -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <CheckBox x:Name="UseRelativePathsCheckBox" 
                              Grid.Column="0"
                              Content="Use Relative Paths" 
                              Style="{StaticResource ThemedCheckBoxStyle}"
                              Checked="UseRelativePathsCheckBox_Changed"
                              Unchecked="UseRelativePathsCheckBox_Changed"
                              ToolTip="Toggle between relative and absolute paths"/>
                    
                    <TextBlock Grid.Column="1" 
                               x:Name="PathTypeHelpText"
                               Text="Currently using absolute paths"
                               FontSize="11" 
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                </Grid>

                <!-- TTS Model Path -->
                <Border BorderBrush="{DynamicResource AccentOrange}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Margin="0,0,0,15"
                        Background="{DynamicResource SurfaceBackgroundLight}">
                    <StackPanel Margin="15">
                        <TextBlock Text="TTS Model File" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="TtsModelPathTextBox" 
                                     Grid.Column="0"
                                     Height="32" 
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource ThemedTextBoxStyle}"
                                     TextChanged="PathTextBox_TextChanged"
                                     ToolTip="Path to TTS model file (.onnx)"
                                     Margin="0,0,8,0"/>
                            
                            <Button x:Name="BrowseTtsModelButton" 
                                    Grid.Column="1"
                                    Content="Browse..." 
                                    Height="32"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Click="BrowseTtsModelButton_Click"
                                    Margin="0,0,8,0"/>
                            
                            <Button x:Name="CreateTtsModelFolderButton" 
                                    Grid.Column="2"
                                    Content="Create" 
                                    Height="32"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Background="{DynamicResource AccentGreen}"
                                    Click="CreateFolderButton_Click"
                                    Tag="TtsModel"
                                    ToolTip="Create folder if it doesn't exist"/>
                        </Grid>
                        
                        <TextBlock x:Name="TtsModelPathWarning" 
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource AccentRed}" 
                                   FontSize="11" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TTS Model Folder -->
                <Border BorderBrush="{DynamicResource AccentOrange}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Margin="0,0,0,15"
                        Background="{DynamicResource SurfaceBackgroundLight}">
                    <StackPanel Margin="15">
                        <TextBlock Text="TTS Model Folder" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="TtsModelFolderTextBox" 
                                     Grid.Column="0"
                                     Height="32" 
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource ThemedTextBoxStyle}"
                                     TextChanged="PathTextBox_TextChanged"
                                     ToolTip="Folder containing TTS models"
                                     Margin="0,0,8,0"/>
                            
                            <Button x:Name="BrowseTtsModelFolderButton" 
                                    Grid.Column="1"
                                    Content="Browse..." 
                                    Height="32"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Click="BrowseTtsModelFolderButton_Click"
                                    Margin="0,0,8,0"/>
                            
                            <Button x:Name="CreateTtsModelFolderFolderButton" 
                                    Grid.Column="2"
                                    Content="Create" 
                                    Height="32"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Background="{DynamicResource AccentGreen}"
                                    Click="CreateFolderButton_Click"
                                    Tag="TtsModelFolder"
                                    ToolTip="Create folder if it doesn't exist"/>
                        </Grid>
                        
                        <TextBlock x:Name="TtsModelFolderWarning" 
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource AccentRed}" 
                                   FontSize="11" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- STT Model Path -->
                <Border BorderBrush="{DynamicResource AccentBlue}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Margin="0,0,0,15"
                        Background="{DynamicResource SurfaceBackgroundLight}">
                    <StackPanel Margin="15">
                        <TextBlock Text="STT Model Path" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="SttModelPathTextBox" 
                                     Grid.Column="0"
                                     Height="32" 
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource ThemedTextBoxStyle}"
                                     TextChanged="PathTextBox_TextChanged"
                                     ToolTip="Path to STT (Vosk) model directory"
                                     Margin="0,0,8,0"/>
                            
                            <Button x:Name="BrowseSttModelButton" 
                                    Grid.Column="1"
                                    Content="Browse..." 
                                    Height="32"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Click="BrowseSttModelButton_Click"
                                    Margin="0,0,8,0"/>
                            
                            <Button x:Name="CreateSttModelFolderButton" 
                                    Grid.Column="2"
                                    Content="Create" 
                                    Height="32"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Background="{DynamicResource AccentGreen}"
                                    Click="CreateFolderButton_Click"
                                    Tag="SttModel"
                                    ToolTip="Create folder if it doesn't exist"/>
                        </Grid>
                        
                        <TextBlock x:Name="SttModelPathWarning" 
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource AccentRed}" 
                                   FontSize="11" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Conversation History Path -->
                <Border BorderBrush="{DynamicResource AccentGreen}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Margin="0,0,0,15"
                        Background="{DynamicResource SurfaceBackgroundLight}">
                    <StackPanel Margin="15">
                        <TextBlock Text="Conversation History Folder" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="ConversationHistoryPathTextBox" 
                                     Grid.Column="0"
                                     Height="32" 
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource ThemedTextBoxStyle}"
                                     TextChanged="PathTextBox_TextChanged"
                                     ToolTip="Folder for conversation history files"
                                     Margin="0,0,8,0"/>
                            
                            <Button x:Name="BrowseConversationHistoryButton" 
                                    Grid.Column="1"
                                    Content="Browse..." 
                                    Height="32"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Click="BrowseConversationHistoryButton_Click"
                                    Margin="0,0,8,0"/>
                            
                            <Button x:Name="CreateConversationHistoryFolderButton" 
                                    Grid.Column="2"
                                    Content="Create" 
                                    Height="32"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Background="{DynamicResource AccentGreen}"
                                    Click="CreateFolderButton_Click"
                                    Tag="ConversationHistory"
                                    ToolTip="Create folder if it doesn't exist"/>
                        </Grid>
                        
                        <TextBlock x:Name="ConversationHistoryPathWarning" 
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource AccentRed}" 
                                   FontSize="11" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- System Prompt Path -->
                <Border BorderBrush="{DynamicResource AccentYellow}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Margin="0,0,0,15"
                        Background="{DynamicResource SurfaceBackgroundLight}">
                    <StackPanel Margin="15">
                        <TextBlock Text="System Prompt File" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   Foreground="{DynamicResource TextPrimary}" 
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="SystemPromptPathTextBox" 
                                     Grid.Column="0"
                                     Height="32" 
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource ThemedTextBoxStyle}"
                                     TextChanged="PathTextBox_TextChanged"
                                     ToolTip="Path to system prompt file (.txt)"
                                     Margin="0,0,8,0"/>
                            
                            <Button x:Name="BrowseSystemPromptButton" 
                                    Grid.Column="1"
                                    Content="Browse..." 
                                    Height="32"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Click="BrowseSystemPromptButton_Click"
                                    Margin="0,0,8,0"/>
                            
                            <Button x:Name="CreateSystemPromptFolderButton" 
                                    Grid.Column="2"
                                    Content="Create" 
                                    Height="32"
                                    Style="{StaticResource ThemedButtonStyle}"
                                    Background="{DynamicResource AccentGreen}"
                                    Click="CreateFolderButton_Click"
                                    Tag="SystemPrompt"
                                    ToolTip="Create folder if it doesn't exist"/>
                        </Grid>
                        
                        <TextBlock x:Name="SystemPromptPathWarning" 
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource AccentRed}" 
                                   FontSize="11" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="ValidatePathsButton" 
                            Grid.Column="1"
                            Content="🔍 Validate All" 
                            Width="120"
                            Height="35"
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentBlue}"
                            Click="ValidatePathsButton_Click"
                            ToolTip="Validate all paths"/>
                    
                    <Button x:Name="ResetPathsButton" 
                            Grid.Column="3"
                            Content="🔄 Reset" 
                            Width="100"
                            Height="35"
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentOrange}"
                            Click="ResetPathsButton_Click"
                            ToolTip="Reset to default paths"/>
                    
                    <Button x:Name="SavePathsButton" 
                            Grid.Column="5"
                            Content="💾 Save" 
                            Width="100"
                            Height="35"
                            Style="{StaticResource ThemedButtonStyle}"
                            Background="{DynamicResource AccentGreen}"
                            Click="SavePathsButton_Click"
                            ToolTip="Save all path settings"/>
                </Grid>

                <!-- Status -->
                <TextBlock x:Name="StatusTextBlock" 
                           Text="Ready to configure paths" 
                           FontSize="11" 
                           Foreground="{DynamicResource TextSecondary}" 
                           Margin="0,15,0,0"
                           TextAlignment="Center"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>